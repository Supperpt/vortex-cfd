FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         {{ "%.4f"|format(end_time) }};   // {{ (end_time / t_cycle)|round(1) }} cardiac cycles

deltaT          1e-5;

// Adaptive time-stepping driven by maxCo.  Mandatory because peak-systolic
// velocity is ~10x the diastolic baseline; a fixed dt either wastes effort
// during diastole or diverges during systole.
adjustTimeStep  yes;
maxCo           {{ max_co }};
maxDeltaT       5e-4;

writeControl    adjustableRunTime;
writeInterval   {{ "%.4f"|format(write_interval) }};   // 50 snapshots / cycle
purgeWrite      0;

writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable yes;

{% if postprocess %}
// ---------------------------------------------------------------------------
// Phase C post-processing function objects (added by --postprocess).
//   wallShearStress writes the KINEMATIC WSS vector (m^2/s^2, i.e. tau/rho)
//   on the wall patch at every snapshot.  Physical WSS in Pa = rho * value.
//   fieldAverage1 averages over the LAST cardiac cycle only (timeStart skips
//   the earlier cycles as transient initialisation) and produces
//   wallShearStressMean + UMean for ParaView visualisation / cross-checking.
//   Authoritative TAWSS / OSI are computed in Python from the per-snapshot
//   wallShearStress fields (see vortex_cfd/postprocess.py).
// ---------------------------------------------------------------------------
functions
{
    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         ({{ wall_patches | join(' ') }});
        writeControl    writeTime;
    }

    fieldAverage1
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        timeStart       {{ "%.4f"|format(field_average_start) }};   // start of the last cycle
        fields
        (
            wallShearStress { mean on; prime2Mean off; base time; }
            U               { mean on; prime2Mean off; base time; }
        );
    }
{% if aneurysm_patch %}

    // Sac pressure on the aneurysm wall patch.  p is KINEMATIC (m^2/s^2);
    // physical Pa = rho * value (applied in postprocess.py).
    surfaceFieldValue_sac_pressure_mean
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            {{ aneurysm_patch }};
        fields          (p);
        operation       areaAverage;
        writeFields     false;
        writeControl    writeTime;
    }

    surfaceFieldValue_sac_pressure_max
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            {{ aneurysm_patch }};
        fields          (p);
        operation       max;
        writeFields     false;
        writeControl    writeTime;
    }
{% endif %}
{# ===========================================================================
   NECK-FLOW METRICS DISABLED for the 0.1.0 release (see CAVEAT-012 / BUG-010 /
   BUG-011 in the development branch docs).  These two surfaceFieldValue FOs are
   scientifically unreliable as written:
     * the infinite sampledSurface plane integrates the whole parent-vessel
       cross-section, not the sac orifice (CAVEAT-012);
     * neck peak velocity uses component-wise max(U) and its parser cannot read
       the parenthesised vector token (BUG-010);
     * neck peak flow uses a sign-naive max() on signed flux (BUG-011).
   The block is preserved (commented) so it can be fixed and re-enabled later:
   clip the plane to the neck orifice, switch to maxMag, peak-by-magnitude, and
   verify in ParaView.  Re-enable by restoring the {% raw %}{% if aneurysm_patch and has_neck_plane %}{% endraw %} guard.
{% if aneurysm_patch and has_neck_plane %}

    // Volumetric flow rate through the neck plane (integral of U.n over the
    // cutting plane, m^3/s).  areaNormalIntegrate writes the result in the
    // first component of a vector.
    surfaceFieldValue_neck_flux
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      sampledSurface;
        name            neckPlaneFlux;
        sampledSurfaceDict
        {
            type            plane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   ( {{ "%.6f"|format(neck_origin[0]) }} {{ "%.6f"|format(neck_origin[1]) }} {{ "%.6f"|format(neck_origin[2]) }} );
                normal  ( {{ "%.6f"|format(neck_normal[0]) }} {{ "%.6f"|format(neck_normal[1]) }} {{ "%.6f"|format(neck_normal[2]) }} );
            }
            source          cells;
            interpolate     true;
        }
        fields          (U);
        operation       areaNormalIntegrate;
        writeFields     false;
        writeControl    writeTime;
    }

    surfaceFieldValue_neck_peak_vel
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      sampledSurface;
        name            neckPlaneVel;
        sampledSurfaceDict
        {
            type            plane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   ( {{ "%.6f"|format(neck_origin[0]) }} {{ "%.6f"|format(neck_origin[1]) }} {{ "%.6f"|format(neck_origin[2]) }} );
                normal  ( {{ "%.6f"|format(neck_normal[0]) }} {{ "%.6f"|format(neck_normal[1]) }} {{ "%.6f"|format(neck_normal[2]) }} );
            }
            source          cells;
            interpolate     true;
        }
        fields          (U);
        operation       max;
        writeFields     false;
        writeControl    writeTime;
    }
{% endif %}
=========================================================================== #}
}
{% endif %}
