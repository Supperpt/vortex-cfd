FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         {{ "%.4f"|format(end_time) }};   // {{ (end_time / t_cycle)|round(1) }} cardiac cycles

deltaT          1e-5;

// Adaptive time-stepping driven by maxCo.  Mandatory because peak-systolic
// velocity is ~10x the diastolic baseline; a fixed dt either wastes effort
// during diastole or diverges during systole.
adjustTimeStep  yes;
maxCo           {{ max_co }};
maxDeltaT       5e-4;

writeControl    adjustableRunTime;
writeInterval   {{ "%.4f"|format(write_interval) }};   // 50 snapshots / cycle
purgeWrite      0;

writeFormat     binary;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   8;

runTimeModifiable yes;

{% if postprocess %}
// ---------------------------------------------------------------------------
// Phase C post-processing function objects (added by --postprocess).
//   wallShearStress writes the KINEMATIC WSS vector (m^2/s^2, i.e. tau/rho)
//   on the wall patch at every snapshot.  Physical WSS in Pa = rho * value.
//   fieldAverage1 averages over the LAST cardiac cycle only (timeStart skips
//   the earlier cycles as transient initialisation) and produces
//   wallShearStressMean + UMean for ParaView visualisation / cross-checking.
//   Authoritative TAWSS / OSI are computed in Python from the per-snapshot
//   wallShearStress fields (see vortex_cfd/postprocess.py).
// ---------------------------------------------------------------------------
functions
{
    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         ({{ wall_patches | join(' ') }});
        writeControl    writeTime;
    }

    fieldAverage1
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        timeStart       {{ "%.4f"|format(field_average_start) }};   // start of the last cycle
        fields
        (
            wallShearStress { mean on; prime2Mean off; base time; }
            U               { mean on; prime2Mean off; base time; }
        );
    }
{% if aneurysm_patch %}

    surfaceFieldValue_sac_pressure_mean
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        surfaceType     patch;
        patches         ({{ aneurysm_patch }});
        fields          (p);
        operation       areaAverage;
        writeControl    writeTime;
    }

    surfaceFieldValue_sac_pressure_max
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        surfaceType     patch;
        patches         ({{ aneurysm_patch }});
        fields          (p);
        operation       max;
        writeControl    writeTime;
    }
{% endif %}
{% if aneurysm_patch and has_neck_plane %}

    surfaceFieldValue_neck_flux
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        surfaceType     plane;
        basePoint       ( {{ "%.6f"|format(neck_origin[0]) }} {{ "%.6f"|format(neck_origin[1]) }} {{ "%.6f"|format(neck_origin[2]) }} );
        normalVector    ( {{ "%.6f"|format(neck_normal[0]) }} {{ "%.6f"|format(neck_normal[1]) }} {{ "%.6f"|format(neck_normal[2]) }} );
        fields          (U);
        operation       sum;
        writeControl    writeTime;
    }

    surfaceFieldValue_neck_peak_vel
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        surfaceType     plane;
        basePoint       ( {{ "%.6f"|format(neck_origin[0]) }} {{ "%.6f"|format(neck_origin[1]) }} {{ "%.6f"|format(neck_origin[2]) }} );
        normalVector    ( {{ "%.6f"|format(neck_normal[0]) }} {{ "%.6f"|format(neck_normal[1]) }} {{ "%.6f"|format(neck_normal[2]) }} );
        fields          (U);
        operation       max;
        writeControl    writeTime;
    }
{% endif %}
}
{% endif %}
