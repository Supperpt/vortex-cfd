FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    {{ wall_patch }}
    {
        type            noSlip;
    }

{% if womersley %}
    {{ inlet_patch }}
    {
        // Womersley analytical inlet profile (Phase B, --womersley).
        // Per-face velocity vectors are pre-computed by vortex_cfd/womersley.py
        // and stored in constant/boundaryData/inlet/ after snappyHexMesh.
        type            timeVaryingMappedFixedValue;
        offset          uniform (0 0 0);
        mapMethod       nearest;
        value           uniform (0 0 0);
    }
{% else %}
    {{ inlet_patch }}
    {
        // Default: parabolic (Poiseuille) profile modulated by the cardiac waveform.
        type            flowRateInletVelocity;
        volumetricFlowRate
        {
            type                table;
            values
            (
{% for t, Q in waveform_table %}
                ( {{ "%.6f"|format(t) }}  {{ "%.6e"|format(Q) }} )
{% endfor %}
            );
            outOfBounds         repeat;
            interpolationScheme linear;
        }
        value           uniform (0 0 0);
    }
{% endif %}

{% for outlet in outlet_patches %}
    {{ outlet }}
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
{% endfor %}

    background
    {
        type            slip;
    }
}
