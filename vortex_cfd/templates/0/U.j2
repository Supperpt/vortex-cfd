FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
{% for patch in wall_patches %}
    {{ patch }}
    {
        type            noSlip;
    }

{% endfor %}
{% if womersley %}
    {{ inlet_patch }}
    {
        // Exact Womersley analytical profile (--womersley). Per-face velocity
        // vectors are pre-computed by vortex_cfd/womersley.py and written to
        // constant/boundaryData/{{ inlet_patch }}/ after snappyHexMesh, because
        // the inlet face centres do not exist until the mesh does.
        //
        // Note this BC has no "outOfBounds repeat" equivalent: past the last
        // supplied time it holds the final value rather than wrapping around.
        // boundaryData is therefore written for the whole run, not one cycle.
        type            timeVaryingMappedFixedValue;
        setAverage      false;
        offset          (0 0 0);
        mapMethod       nearest;
        value           uniform (0 0 0);
    }
{% else %}
    {{ inlet_patch }}
    {
        // Default: parabolic (Poiseuille) profile scaled by the cardiac waveform.
        type            flowRateInletVelocity;
        volumetricFlowRate
        {
            type                table;
            values
            (
{% for t, Q in waveform_table %}
                ( {{ "%.6f"|format(t) }}  {{ "%.6e"|format(Q) }} )
{% endfor %}
            );
            outOfBounds         repeat;
            interpolationScheme linear;
        }
        value           uniform (0 0 0);
    }
{% endif %}

{% for outlet in outlet_patches %}
    {{ outlet }}
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
{% endfor %}

    background
    {
        type            slip;
    }
}
